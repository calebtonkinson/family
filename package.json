{
  "name": "home-management",
  "private": true,
  "packageManager": "yarn@4.6.0",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "tooling/*"
  ],
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "clean": "turbo clean && rm -rf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:watch": "turbo test:watch --parallel",
    "test:e2e": "playwright test",
    "check:repo": "node ./tooling/scripts/check-route-registry.mjs && node ./tooling/scripts/check-env-contract.mjs && node ./tooling/scripts/check-workspace-boundaries.mjs",
    "deploy:web": "bash ./tooling/scripts/deploy-web.sh",
    "deploy:backend": "bash ./tooling/scripts/deploy-backend.sh"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@vitest/coverage-v8": "^4.0.18",
    "prettier": "^3.2.5",
    "turbo": "^2.3.4",
    "typescript": "^5.7.3",
    "vite": "^7.3.1",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "@ai-sdk/react": "^3.0.66"
  }
}
